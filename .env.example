# Dot.Ehail environment. This file is copied to .env by CI and by new developers, so every value here works on a
# laptop and in CI; the live value is in the comment beside it. On the host, set the live values in <app>/.env, then
# `php artisan config:cache` and `php artisan ehail:preflight` (it names every missing owner step).
# Never commit a real key or secret. docs/R46_OPERATIONS.md is the owner runbook; docs/deployment.md the host checklist.

APP_NAME="Dot.Ehail"
APP_ENV=local                     # live: production (the deploy forces it)
APP_KEY=                          # php artisan key:generate, ONCE. It encrypts driver licence/ID numbers, card tokens
                                  # and ride PINs: back it up OFF the host with every database backup, never rotate it.
APP_DEBUG=false                   # never true on a public host (debug pages show code and environment values); the deploy forces false
APP_URL=http://localhost          # live: https://ehail.infodot.co.za (links in emails, trip shares, Paystack callback)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug                   # live: warning (the apps poll every few seconds; debug floods the log)

# Database. Local and CI: SQLite (database/database.sqlite). Live: PostgreSQL is what the platform is built and
# load-tested for (DB_CONNECTION=pgsql, DB_HOST=127.0.0.1, DB_PORT=5432, DB_DATABASE, DB_USERNAME, DB_PASSWORD).
# If the host runs SQLite, ehail:preflight warns and docs/R46_OPERATIONS.md says what that costs.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# SESSION_SECURE_COOKIE=true      # defaults to true when APP_URL is https (config/session.php)

# Shared cPanel has no Redis and no daemons: database queue and cache, a cron-driven worker, no websocket server.
BROADCAST_CONNECTION=log          # live: log. Reverb cannot run on shared hosting; the screens poll instead.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. log = nobody receives anything (safety alerts, receipts, password resets are recorded as NOT delivered).
# Live: MAIL_MAILER=smtp, MAIL_SCHEME=smtps or smtp, MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD (the
# no-reply@infodot.co.za account the other Dot apps use).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb (only on a host that can run `php artisan reverb:start` under a supervisor; never on shared cPanel).
# A unique id/key/secret per environment: php -r 'echo bin2hex(random_bytes(20));'
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8080

# Baked into the frontend at BUILD time only. The deploy builds on the runner with none of these, so the live bundle
# never opens a websocket.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Ecosystem sign-in (InfoDot). INFODOT_SERVICE_SECRET must equal ECOSYSTEM_SECRET_EHAIL in InfoDot's .env.
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=ehail
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true
# Platform switcher links (config/ecosystem.php): live DOT_INFODOT_URL=https://infodot.co.za and one
# DOT_<KEY>_URL=https://<key>.infodot.co.za per linked platform.
# DOT_INFODOT_URL=https://infodot.co.za

# Public sign-up is closed; InfoDot creates accounts at first sign-in. true only for a deliberate window.
ALLOW_REGISTRATION=false

# ---- Security headers. HSTS max-age in seconds on https (0 = off). The nonce-based CSP is ENFORCED;
# SECURITY_CSP_REPORT_ONLY=true turns it back into report-only without a deploy (escape hatch, docs/R46_SECURITY.md).
SECURITY_HSTS_SECONDS=15552000
SECURITY_CSP_REPORT_ONLY=false

# ---- Security and privacy (config/ehail_security.php): recent sign-in window for sensitive changes, payout account
# cooling-off, new-device notices, card-setup abuse limits. Retention periods (POPIA) are listed under Advanced tuning.
EHAIL_REAUTH_MINUTES=15
EHAIL_PAYOUT_COOLING_OFF_HOURS=72
EHAIL_NEW_DEVICE_NOTICE=true
# EHAIL_CARD_SETUP_PER_USER_DAILY=20
# EHAIL_CARD_SETUP_PER_IP_HOURLY=20

# ================================ R-46 providers (each is OFF until configured; preflight shows the state) ==========

# ---- Routing: THE most important owner step. none = nobody can book (no road route, no price).
# Live: EHAIL_ROUTING_DRIVER=google + EHAIL_GOOGLE_MAPS_SERVER_KEY (Routes API), or ors + EHAIL_ORS_KEY,
# or mapbox + EHAIL_MAPBOX_SERVER_TOKEN, or osrm/valhalla + a server URL you run or contract.
EHAIL_ROUTING_DRIVER=none
# EHAIL_GOOGLE_MAPS_SERVER_KEY=
# EHAIL_MAPBOX_SERVER_TOKEN=
# EHAIL_ORS_KEY=
# EHAIL_ORS_URL=https://api.openrouteservice.org
# EHAIL_OSRM_URL=
# EHAIL_VALHALLA_URL=
EHAIL_ROUTING_TIMEOUT=4
EHAIL_ROUTING_CACHE_TTL=600

# ---- Address search: public OSM Nominatim by default (1 request/s for the whole platform, search on Enter only).
# google | mapbox | ors | photon turn on search-as-you-type (they reuse the keys above; photon needs EHAIL_PHOTON_URL).
EHAIL_GEOCODING_DRIVER=nominatim
# EHAIL_PHOTON_URL=
# EHAIL_NOMINATIM_URL=https://nominatim.openstreetmap.org
# EHAIL_NOMINATIM_RPS=1
EHAIL_GEOCODING_COUNTRY=ZA
EHAIL_GEOCODING_LANGUAGE=en
EHAIL_GEOCODING_TIMEOUT=4
# EHAIL_GEO_USER_AGENT="Dot.Ehail/1.0 (+https://ehail.infodot.co.za)"

# ---- Map tiles (raster XYZ). The OSMF server has no SLA; contract a provider before traffic grows and restrict a
# keyed URL to this site by HTTP referrer at the provider. EHAIL_TILES_KIND=osm adds the "report a map issue" link.
EHAIL_TILES_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
EHAIL_TILES_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
EHAIL_TILES_KIND=osm
EHAIL_TILES_MAX_ZOOM=19
EHAIL_TILES_SIZE=256

# Location data retention (POPIA): raw trip trails are summarised and deleted after this many days.
EHAIL_TRIP_POINTS_RETENTION_DAYS=90
EHAIL_LOCATION_MAX_ACCURACY_M=150

# ---- Card payments: Paystack. Blank = card payments off. sk_test_/pk_test_ = test mode (no real money).
# A sk_live_ key is REFUSED unless PAYSTACK_ALLOW_LIVE=true is ALSO set (the owner's deliberate second switch).
# Webhook URL to give Paystack (Settings, API Keys and Webhooks): {APP_URL}/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_ALLOW_LIVE=false
PAYSTACK_ATTEMPT_TTL_MINUTES=30
EHAIL_CARD_SETUP_AMOUNT_MINOR=100          # R1.00 card check, refunded at once

# ---- Cash. With no usable card payments AND cash off, every ride request is refused (no way to collect the fare).
EHAIL_CASH_ENABLED=false
EHAIL_CASH_CATEGORIES=                     # empty = every category; or a comma list of category keys
EHAIL_CASH_DISCREPANCY_TOLERANCE=0

# ---- Money: commission (used when no published commission plan applies), payouts, receipts, VAT
EHAIL_CURRENCY_CODE=ZAR
EHAIL_CURRENCY_SYMBOL=R
EHAIL_COMMISSION_PERCENT=20
EHAIL_CANCELLATION_DRIVER_SHARE=80
EHAIL_EARNINGS_HOLD_HOURS=0
EHAIL_PAYOUT_DAY=1                         # ISO weekday the weekly payout batch is drafted (1 = Monday)
EHAIL_PAYOUT_TIME=06:00
EHAIL_PAYOUT_MINIMUM_MINOR=5000            # R50; below it the balance carries forward
EHAIL_FLEET_DRIVER_PAYEE=driver            # driver | fleet_owner (per-fleet override in the fleet portal)
EHAIL_PAYSTACK_TRANSFERS=false             # true = pay out through Paystack Transfers (Registered Business, OTP off)
EHAIL_VERIFY_PAYOUT_ACCOUNTS=true
EHAIL_CHARGE_RETRY_MINUTES=15,120,1440
EHAIL_CHARGE_PENDING_VERIFY_SECONDS=90
EHAIL_PAYMENT_DUE_GRACE_MINUTES=15
EHAIL_UNPAID_FARE_ALERT_HOURS=24
EHAIL_EMAIL_RECEIPTS=true
EHAIL_RECEIPT_PREFIX=EHR
# Operator identity on receipts and business statements (D-1905). Leave a value unset rather than invent it:
# documents then leave the line off and `php artisan ehail:preflight` lists what is missing.
# EHAIL_OPERATOR_LEGAL_NAME=                 # the operating company's registered name
# EHAIL_OPERATOR_TRADING_NAME="${APP_NAME}"
# EHAIL_OPERATOR_REGISTRATION=               # CIPC registration number, e.g. 2024/123456/07
# EHAIL_OPERATOR_ADDRESS=                    # lines separated with |
# EHAIL_VAT_REGISTERED=false                 # state it (true or false); unset = no VAT statement is made
# EHAIL_VAT_NUMBER=
EHAIL_VAT_RATE=15
# EHAIL_SUPPORT_EMAIL=                       # a real inbox, never a no-reply address
# EHAIL_SUPPORT_PHONE=
# EHAIL_SUPPORT_URL=
# EFT details printed on business statements:
# EHAIL_EFT_ACCOUNT_NAME=
# EHAIL_EFT_BANK=
# EHAIL_EFT_ACCOUNT_NUMBER=
# EHAIL_EFT_BRANCH_CODE=
# EHAIL_EFT_ACCOUNT_TYPE=

# ---- Pricing. Prices themselves are NOT configured here: an operator publishes the tariff in /ops/tariffs.
EHAIL_PRICING_COUNTRY=ZA
EHAIL_PRICING_TIMEZONE=Africa/Johannesburg
EHAIL_QUOTE_TTL_SECONDS=300
EHAIL_QUOTE_ROUTE_MATCH_M=75
EHAIL_QUOTE_RETAIN_HOURS=24
EHAIL_QUOTE_PER_MINUTE=30
EHAIL_ESTIMATE_PER_MINUTE=20
# A long-distance ride is offered only from this trip length (D-2003); an airport transfer needs an airport zone at one end.
# EHAIL_LONG_DISTANCE_MIN_KM=40

# ---- Dispatch (defaults are researched; change only with a reason). Polling intervals in seconds.
EHAIL_PIN_REQUIRED=true
EHAIL_OFFER_TIMEOUT_SECONDS=15
EHAIL_OPEN_BOARD_AFTER_SECONDS=45
EHAIL_SEARCH_RADII_M=2000,4000,7000,10000
EHAIL_NO_SHOW_WAIT_MINUTES=5
EHAIL_RIDE_EXPIRY_MINUTES=10
EHAIL_STUCK_RIDE_HOURS=6
# Superseded by the adaptive hints under "Performance and health" below (still read by config/ehail_dispatch.php):
# EHAIL_POLL_PASSENGER_ACTIVE=3
# EHAIL_POLL_DRIVER_ONLINE=2
EHAIL_BROADCAST_RIDE_EVENTS=false          # true only where Reverb runs
EHAIL_SCHEDULE_MIN_LEAD_MINUTES=30
EHAIL_SCHEDULE_MAX_LEAD_DAYS=30
EHAIL_SCHEDULE_PRICE_GUARANTEE_PERCENT=10
EHAIL_DRIVER_LATE_GRACE_SECONDS=300

# ---- Performance and health (config/ehail_perf.php, docs/R46_PERF.md). Measured, not guessed.
# CACHE_LIMITER=file                       # RECOMMENDED on the host: rate-limiter counters in files, not the database (a third fewer statements per poll)
# SESSION_LOTTERY_CHANCE=1                 # expired-session sweep on 1 request in 1,000
# EHAIL_SESSION_TOUCH_SECONDS=60           # an unchanged session row is rewritten at most once a minute (0 = every request)
# EHAIL_PERF_PROBE=false                   # cost headers for the load scripts; refused outside local/testing
# Polling hints (Retry-After, seconds). Driver: offer on screen, on a trip, waiting, waiting in saver mode, paused, offline.
# EHAIL_POLL_DRIVER_OFFER=2
# EHAIL_POLL_DRIVER_TRIP=3
# EHAIL_POLL_DRIVER_IDLE=3
# EHAIL_POLL_DRIVER_SAVER=6
# EHAIL_POLL_DRIVER_PAUSED=15             # offline: EHAIL_POLL_DRIVER_OFFLINE (30), listed with dispatch's defaults
# EHAIL_DRIVER_PARKED_POST_EVERY_SECONDS=15  # a parked driver's position goes up this often (moving: every sync)
# EHAIL_HEARTBEAT_WRITE_EVERY_SECONDS=20     # a sync without a position refreshes the heartbeat this often
# Passenger: searching, driver on the way, in the car, scheduled or ended (the app pauses while its tab is hidden).
# EHAIL_POLL_PASSENGER_SEARCHING=3
# EHAIL_POLL_PASSENGER_APPROACHING=3
# EHAIL_POLL_PASSENGER_IN_PROGRESS=5
# EHAIL_POLL_PASSENGER_SCHEDULED=30
# EHAIL_POLL_PASSENGER_HIDDEN=15
# EHAIL_ETA_REUSE_SECONDS=30               # the passenger's road ETA is asked again at most this often per ride
# EHAIL_ETA_RECOMPUTE_AFTER_M=400          # ...or when the driver moved this far since
# Health (php artisan ehail:health, GET /ops/status, /up/realtime). Alerts go to this address when set.
EHAIL_HEALTH_ALERT_EMAIL=
# EHAIL_HEALTH_ALERT_EVERY_MINUTES=30
# EHAIL_HEALTH_QUEUE_LAG_WARN=120
# EHAIL_HEALTH_QUEUE_LAG_FAIL=600
# EHAIL_HEALTH_FAILED_JOBS_WARN=1
# EHAIL_HEALTH_FAILED_JOBS_FAIL=25
# EHAIL_HEALTH_TICK_WARN=150
# EHAIL_HEALTH_TICK_FAIL=600
# EHAIL_HEALTH_SCHEDULE_WARN=150
# EHAIL_HEALTH_STALE_DRIVER_WARN=0.25
# EHAIL_HEALTH_STALE_DRIVER_FAIL=0.6
# EHAIL_HEALTH_WEBHOOK_LAG_WARN=900
# EHAIL_HEALTH_WEBHOOK_LAG_FAIL=3600
# EHAIL_HEALTH_NOTIFY_FAILED_WARN=5
# EHAIL_HEALTH_NOTIFY_FAILED_FAIL=50
# EHAIL_HEALTH_NOTIFY_DUE_WARN=200

# ---- Safety and verification
EHAIL_MARKET=ZA
# true: every driver needs every required document APPROVED before going online (existing approved drivers too).
# false only for a planned transition window (logged on every go-online decision).
EHAIL_VERIFICATION_REQUIRE_DOCUMENTS=true
# Metres cut off each end of the road line on the public trip-share map, so it never marks a door (default 300).
# EHAIL_TRIP_SHARE_ROUTE_TRIM_M=300
EHAIL_CHECKIN_MINUTES=3
# Who is escalated to when an SOS is not acknowledged (comma lists). Empty = only the operators are reminded.
EHAIL_SAFETY_ONCALL_EMAILS=
EHAIL_SAFETY_ONCALL_USER_IDS=
EHAIL_SAFETY_MANAGER_EMAILS=
EHAIL_SAFETY_MANAGER_USER_IDS=
# SMS: null = no SMS is ever sent (or claimed). bulksms needs both token values.
EHAIL_SMS_DRIVER=null
# BULKSMS_TOKEN_ID=
# BULKSMS_TOKEN_SECRET=
# BULKSMS_SENDER=
# BULKSMS_ENDPOINT=https://api.bulksms.com/v1/messages

# ---- Web Push (VAPID). php artisan ehail:comms-vapid-keys prints all three lines. Blank = push off.
# EHAIL_VAPID_PUBLIC_KEY=
# EHAIL_VAPID_PRIVATE_KEY=
EHAIL_VAPID_SUBJECT=mailto:no-reply@infodot.co.za
EHAIL_COMMS_RETENTION_DAYS=90

# ---- Business accounts
EHAIL_BUSINESS_TIMEZONE=Africa/Johannesburg
EHAIL_BUSINESS_STATEMENT_PREFIX=EHB
EHAIL_BUSINESS_INVITE_DAYS=14

# ---- Fleets
EHAIL_FLEET_DOCUMENT_EXPIRY_DAYS=30
EHAIL_FLEET_SERVICE_DUE_DAYS=14
EHAIL_FLEET_SERVICE_DUE_KM=1000

# ---- Email events via Dot.Notify (blank = not sent). The secret is NOTIFY_INGEST_SECRET_EHAIL in Dot.Notify's .env.
# Live URL: https://notify.infodot.co.za/api/ingest/events
NOTIFY_INGEST_URL=
NOTIFY_INGEST_SECRET=
NOTIFY_PLATFORM_KEY=ehail

# ---- Daily aggregate snapshot to Dot.Analytics (blank = nothing collected or sent). The secret is
# ANALYTICS_INGEST_SECRET_EHAIL in Dot.Analytics' .env; ANALYTICS_COMPANY_UUID is the operator's InfoDot company.
ANALYTICS_INGEST_URL=
ANALYTICS_INGEST_SECRET=
ANALYTICS_PLATFORM_KEY=ehail
ANALYTICS_COMPANY_UUID=

# ---- Advanced tuning: every value below is the built-in default. Uncomment a line only to change it, with a reason.
# config/ehail_security.php (retention in days; the scheduled privacy purge applies them, docs/R46_PRIVACY.md)
# EHAIL_RETAIN_AUDIT_DAYS=2190
# EHAIL_RETAIN_BUSINESS_APPROVALS_DAYS=365
# EHAIL_RETAIN_DECLINED_CONTACTS_DAYS=30
# EHAIL_RETAIN_EVENT_COORDS_DAYS=90
# EHAIL_RETAIN_FAILED_JOBS_DAYS=30
# EHAIL_RETAIN_INCIDENT_DAYS=1825
# EHAIL_RETAIN_INCIDENT_TRAIL_DAYS=365
# EHAIL_RETAIN_NOTIFICATIONS_DAYS=180
# EHAIL_RETAIN_QUOTE_COORDS_DAYS=90
# EHAIL_RETAIN_ROUTE_POLYLINES_DAYS=90
# EHAIL_RETAIN_SUPERSEDED_DOCS_DAYS=90
# EHAIL_RETAIN_SUPPORT_DAYS=730
# EHAIL_RETAIN_WEBHOOK_DAYS=365
# EHAIL_TRIP_CHANGE_ROAD_FACTOR=2.0
# config/ehail.php
# EHAIL_BASE_FARE=25.0
# EHAIL_MAX_REASSIGNMENTS=3
# EHAIL_PER_KM=8.5
# config/ehail_business.php
# EHAIL_BUSINESS_APPROVAL_FARE_TOLERANCE_BP=1500
# EHAIL_BUSINESS_APPROVAL_STOP_TOLERANCE_M=1000
# EHAIL_BUSINESS_APPROVAL_USE_MINUTES=120
# EHAIL_BUSINESS_GUEST_PHONE_DAYS=30
# EHAIL_BUSINESS_RELEASE_HOURS=24
# config/ehail_comms.php
# EHAIL_COMMS_APPROACHING_M=500
# EHAIL_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,android.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,push.apple.com,notify.windows.com
# config/ehail_dispatch.php
# EHAIL_DECLINE_COOLDOWN_MINUTES=5
# EHAIL_DECLINE_COOLDOWN_THRESHOLD=3
# EHAIL_DECLINE_COOLDOWN_WINDOW_MINUTES=10
# EHAIL_DISPATCH_CANDIDATE_LIMIT=20
# EHAIL_DISPATCH_LEASE_SECONDS=5
# EHAIL_DISPATCH_RETRY_SECONDS=3
# EHAIL_ETA_DETOUR_FACTOR=1.4
# EHAIL_ETA_MAX_SECONDS=3600
# EHAIL_ETA_ROUTER_BUDGET_MS=400
# EHAIL_ETA_ROUTER_MAX_CANDIDATES=5
# EHAIL_ETA_SPEED_KMH=25
# EHAIL_GLOBAL_TICK_BATCH=5
# EHAIL_GLOBAL_TICK_EVERY_SECONDS=2
# EHAIL_HEARTBEAT_STALE_SECONDS=45
# EHAIL_IDEMPOTENCY_HOURS=24
# EHAIL_PIN_LOCK_MINUTES=10
# EHAIL_PIN_MAX_ATTEMPTS=5
# EHAIL_POLL_DRIVER_OFFLINE=30
# EHAIL_POLL_PASSENGER_IDLE=30
# EHAIL_SCHEDULE_ALLOCATION_LEAD_MINUTES=15
# EHAIL_SCHEDULE_FREE_CHANGE_MINUTES=60
# EHAIL_SCHEDULE_GRACE_MINUTES=10
# EHAIL_SCHEDULE_REMINDER_LEAD_MINUTES=60
# EHAIL_W_COOLDOWN_S=60
# EHAIL_W_ETA=1.0
# EHAIL_W_IDLE=0.1
# EHAIL_W_IDLE_CAP_S=1800
# EHAIL_W_TRIP_BALANCE_CAP_S=120
# EHAIL_W_TRIP_BALANCE_S=30
# config/ehail_driver.php
# EHAIL_DRIVER_ARRIVAL_ACCURACY_CAP_M=100
# EHAIL_DRIVER_ARRIVAL_MAX_FIX_AGE_S=120
# EHAIL_DRIVER_ARRIVAL_TOLERANCE_M=250
# EHAIL_DRIVER_HEARTBEAT_EVERY_S=10
# EHAIL_DRIVER_LOCATION_EVERY_S=4
# EHAIL_DRIVER_LOCATION_SAVER_EVERY_S=8
# EHAIL_DRIVER_MOVING_ENTER_KMH=10
# EHAIL_DRIVER_MOVING_EXIT_AFTER_S=10
# EHAIL_DRIVER_MOVING_EXIT_KMH=5
# EHAIL_DRIVER_OFFER_DESTINATION=area
# EHAIL_DRIVER_TIMEZONE=Africa/Johannesburg
# config/ehail_fleet.php
# EHAIL_FLEET_IDLE_ASSIGNMENT_HOURS=24
# config/ehail_pricing.php
# EHAIL_PRICING_CURRENCY=ZAR          # defaults to EHAIL_CURRENCY_CODE
# config/money.php
# EHAIL_CARD_SETUP_RETURN=/dashboard
# EHAIL_SETTLEMENT_SWEEP_AFTER_MINUTES=15   # ehail:settlement-sweep queues settlement for completed rides unsettled this long (min 11)
# EHAIL_SETTLEMENT_SWEEP_LOOKBACK_DAYS=7

# A commented line (# KEY=) has no value until you set one: leaving it out keeps the documented default.
# tests/Feature/Deploy/EnvExampleTest.php fails when a config file reads a variable this file does not list.
